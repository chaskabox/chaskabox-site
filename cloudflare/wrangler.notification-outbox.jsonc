{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chaskabox-notification-outbox",
  "main": "../workers/notification-outbox.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "NOTIFICATION_DISPATCH_ENABLED": "false",
    "ANALYTICS_RETENTION_ENABLED": "false",
    "NOTIFICATION_DISPATCH_AFTER": "",
    "NOTIFICATION_CHANNELS": "owner_email",
    "WAHA_OWNER_CANARY_ENABLED": "false",
    "WAHA_WEBHOOK_SETUP_ENABLED": "false",
    "WAHA_WEBHOOK_VERIFY_ENABLED": "false",
    "WAHA_SESSION": "default",
    "PUBLIC_BASE_URL": "https://chaskabox.online",
    "ADMIN_BASE_URL": "https://chaskabox.online"
  }
  // Private Worker secrets: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
  // RESEND_API_KEY, RESEND_FROM_EMAIL, OWNER_ORDER_EMAIL,
  // WAHA_API_URL, WAHA_API_KEY, OWNER_WHATSAPP, OUTBOX_RUN_SECRET,
  // RESEND_WEBHOOK_SECRET, WAHA_WEBHOOK_SECRET, WAHA_CF_ACCESS_CLIENT_ID,
  // WAHA_CF_ACCESS_CLIENT_SECRET.
  // Safe defaults: only owner email eligible. Never opt WhatsApp channels in via a code deploy.
}
